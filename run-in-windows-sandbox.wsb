<Configuration>
  <VGpu>Disable</VGpu>
  <Networking>Default</Networking>
  <MappedFolders>
    <MappedFolder>
      <HostFolder>D:\os</HostFolder>
      <SandboxFolder>C:\auroraos</SandboxFolder>
      <ReadOnly>true</ReadOnly>
    </MappedFolder>
  </MappedFolders>
  <LogonCommand>
    <Command>powershell.exe -ExecutionPolicy Bypass -NoProfile -File C:\auroraos\scripts\sandbox-logon.ps1</Command>
  </LogonCommand>
</Configuration>
